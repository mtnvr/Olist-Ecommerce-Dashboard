{
  "name": "Olist White Infographic",
  "dataColors": [
    "#6366F1",
    "#F59E0B",
    "#22C55E",
    "#F43F5E",
    "#0EA5E9",
    "#EC4899",
    "#8B5CF6",
    "#14B8A6"
  ],
  "background": "#FFFFFF",
  "foreground": "#1E293B",
  "tableAccent": "#6366F1",
  "bad": "#F43F5E",
  "neutral": "#94A3B8",
  "good": "#22C55E",
  "maximum": "#22C55E",
  "center": "#F59E0B",
  "minimum": "#F43F5E",
  "null": "#E2E8F0",
  "visualStyles": {
    "*": {
      "*": {
        "background": [{"color":{"solid":{"color":"#FFFFFF"}},"transparency":0}],
        "border":     [{"color":{"solid":{"color":"#E2E8F0"}},"show":true}],
        "title": [{
          "fontColor":  {"solid":{"color":"#1E293B"}},
          "background": {"solid":{"color":"#FFFFFF"}},
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }]
      }
    },
    "card": {
      "*": {
        "calloutValue": [{"fontSize":24,"fontFamily":"Segoe UI Bold","color":{"solid":{"color":"#6366F1"}}}],
        "label":        [{"fontSize":10,"fontFamily":"Segoe UI","color":{"solid":{"color":"#64748B"}}}],
        "background":   [{"color":{"solid":{"color":"#FFFFFF"}},"transparency":0}]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [{"labelColor":{"solid":{"color":"#64748B"}},"fontSize":9}],
        "valueAxis":    [{"labelColor":{"solid":{"color":"#64748B"}},"fontSize":9,"gridlineColor":{"solid":{"color":"#F1F5F9"}}}],
        "dataLabels":   [{"color":{"solid":{"color":"#1E293B"}},"fontSize":9}]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [{"labelColor":{"solid":{"color":"#64748B"}},"fontSize":9}],
        "valueAxis":    [{"labelColor":{"solid":{"color":"#64748B"}},"fontSize":9,"gridlineColor":{"solid":{"color":"#F1F5F9"}}}],
        "dataLabels":   [{"color":{"solid":{"color":"#1E293B"}},"fontSize":9}]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [{"labelColor":{"solid":{"color":"#64748B"}},"fontSize":9}],
        "valueAxis":    [{"labelColor":{"solid":{"color":"#64748B"}},"fontSize":9,"gridlineColor":{"solid":{"color":"#F1F5F9"}}}]
      }
    },
    "donutChart": {
      "*": {
        "dataLabels": [{"color":{"solid":{"color":"#1E293B"}},"fontSize":9}]
      }
    },
    "pieChart": {
      "*": {
        "dataLabels": [{"color":{"solid":{"color":"#1E293B"}},"fontSize":9}]
      }
    },
    "slicer": {
      "*": {
        "data":       [{"fontColor":{"solid":{"color":"#1E293B"}},"fontSize":10,"fontFamily":"Segoe UI"}],
        "background": [{"color":{"solid":{"color":"#F8FAFC"}},"transparency":0}]
      }
    },
    "matrix": {
      "*": {
        "columnHeaders": [{"fontColor":{"solid":{"color":"#FFFFFF"}},"backColor":{"solid":{"color":"#6366F1"}},"fontSize":10}],
        "rowHeaders":    [{"fontColor":{"solid":{"color":"#1E293B"}},"backColor":{"solid":{"color":"#F8FAFC"}},"fontSize":10}],
        "values":        [{"fontColor":{"solid":{"color":"#1E293B"}},"fontSize":10}]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{"fontColor":{"solid":{"color":"#FFFFFF"}},"backColor":{"solid":{"color":"#6366F1"}},"fontSize":10}],
        "values":        [{"fontColor":{"solid":{"color":"#1E293B"}},"backColor":{"solid":{"color":"#FFFFFF"}},"fontSize":10}]
      }
    }
  }
}
